{
  "name": "Sales Knowledge Agent - Ingestion",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "name": "Run ingestion"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_DRIVE_FOLDER_ID",
            "mode": "id"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        208,
        0
      ],
      "name": "List documents",
      "credentials": {
        "googleDriveOAuth2Api": {
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        416,
        0
      ],
      "name": "Download file",
      "credentials": {
        "googleDriveOAuth2Api": {
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "text",
        "destinationKey": "content",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        624,
        0
      ],
      "name": "Extract text"
    },
    {
      "parameters": {
        "jsCode": "const chunks = [];\nconst items = $input.all();\n\nitems.forEach((item, i) => {\n  const content = item.json.content || '';\n\n  // The file name lives in the Drive listing, so look it up by matching item\n  let source = 'unknown';\n  try { source = $('List documents').itemMatching(i).json.name; } catch (e) {}\n\n  // First line is the document title, e.g. \"# Hirelane Pricing and Packaging\"\n  const title = (content.match(/^#\\s+(.+)$/m) || [])[1] || source;\n\n  // Split at every \"## \" heading, keeping the heading with its text\n  const parts = content.split(/\\n(?=##\\s)/);\n\n  for (const part of parts) {\n    const heading = (part.match(/^##\\s+(.+)$/m) || [])[1] || 'Overview';\n    const text = part.trim();\n    if (text.length < 40) continue;   // skip title-only fragments\n\n    chunks.push({ json: {\n      // Title and heading go into the embedded text, so a chunk\n      // still makes sense when retrieved on its own\n      content: `${title} > ${heading}\\n\\n${text}`,\n      metadata: { source, section: heading }\n    }});\n  }\n});\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "name": "Split into chunks"
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "value": "documents",
          "mode": "list",
          "cachedResultName": "documents"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        1056,
        0
      ],
      "name": "Store in Supabase",
      "credentials": {
        "supabaseApi": {
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.content }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source",
                "value": "={{ $json.metadata.source }}"
              },
              {
                "name": "section",
                "value": "={{ $json.metadata.section }}"
              }
            ]
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1024,
        208
      ],
      "name": "Default Data Loader"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        1232,
        208
      ],
      "name": "Embeddings OpenAI",
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "chunkOverlap": 100,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1024,
        400
      ],
      "name": "Recursive Character Text Splitter"
    },
    {
      "parameters": {
        "content": "## Ingestion\nRuns once, or whenever the documents change.\n\nDrive -> text -> split by `##` heading -> embed -> Supabase.\n\nEach chunk keeps its source file and section as metadata, so answers can cite them.",
        "width": 1360,
        "height": 180,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -32,
        -224
      ],
      "name": "note_[-32, -224]"
    }
  ],
  "connections": {
    "Run ingestion": {
      "main": [
        [
          {
            "node": "List documents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List documents": {
      "main": [
        [
          {
            "node": "Download file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download file": {
      "main": [
        [
          {
            "node": "Extract text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract text": {
      "main": [
        [
          {
            "node": "Split into chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split into chunks": {
      "main": [
